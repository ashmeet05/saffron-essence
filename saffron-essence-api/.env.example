# Copy this file to .env and fill in your own values. NEVER commit .env to GitHub.

PORT=4000

# MongoDB connection string. Use a NEW database name (e.g. saffron-essence)
# so it doesn't mix with your portfolio data.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/saffron-essence?retryWrites=true&w=majority

# Long random text used to sign login tokens (32+ characters).
# Make one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Member email(s) that can open the staff dashboard (comma-separated)
ADMIN_EMAILS=you@example.com

# Where the website files are (served at http://localhost:4000)
FRONTEND_DIR=../saffron-essence-v2

# Extra websites allowed to call the API (comma-separated), e.g. your live site
CORS_ORIGINS=http://localhost:4000,http://127.0.0.1:5500
